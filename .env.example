# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# Языковая модель: OpenAI-совместимый Chat Completions API.
# Для YandexGPT (Yandex AI Studio): сервисный аккаунт с ролью ai.languageModels.user
# и его API-ключ. ID каталога (folder ID) не секретен, ключ — секрет.
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Ключ доступа к модели (обязательно). Никогда не добавляйте его в Git и отчёт.
LLM_API_KEY=
# Модель (обязательно), например gpt://b1gexamplefolder/yandexgpt-lite/latest,
# где b1gexamplefolder — ID вашего каталога. Пустое поле start-скрипт заполнит сам.
LLM_MODEL=
# ID каталога Yandex Cloud, передаётся в заголовке OpenAI-Project. Для других провайдеров пусто.
LLM_PROJECT=
# Таймаут одного обращения к модели, секунды (1–300).
LLM_TIMEOUT=30
# Максимальная длина ответа модели в токенах.
LLM_MAX_TOKENS=1500

# Ограничения истории диалога, передаваемой модели.
# Число последних сообщений (вопросы и ответы вместе), 2–200.
HISTORY_MAX_MESSAGES=20
# Суммарный объём истории и текущего сообщения в символах, 4096–200000.
# Символы — оценка объёма; фактический расход токенов бот пишет в лог (usage).
HISTORY_MAX_CHARS=12000
